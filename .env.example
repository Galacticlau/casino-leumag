PORT=3000
NODE_ENV=development
SESSION_SECRET=

# Es opcional. Si se deja vacío, el programa intenta detectar la IP del computador.
PUBLIC_URL=

# Déjalo vacío para usar la base local sin Docker. En Railway, coloca aquí
# la variable DATABASE_URL entregada por el servicio PostgreSQL.
DATABASE_URL=
DATABASE_POOL_SIZE=12
DATABASE_SSL=false

# La cuenta administradora inicial se crea solo si aún no existe ningún usuario.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administración
