<%- include('partials/header') %>
<section class="narrow-panel panel">
  <span class="eyebrow">Seguridad de la cuenta</span>
  <h1>Cambiar clave</h1>
  <% if (currentUser.mustChangePassword) { %>
    <div class="notice">Esta cuenta usa una clave temporal. Debes reemplazarla antes de continuar.</div>
  <% } %>
  <form method="post" action="/account/password" class="form-stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Clave actual<input type="password" name="currentPassword" required autocomplete="current-password"></label>
    <label>Nueva clave<input type="password" name="newPassword" required minlength="6" autocomplete="new-password"></label>
    <label>Repetir nueva clave<input type="password" name="confirmation" required minlength="6" autocomplete="new-password"></label>
    <button class="button button-primary" type="submit">Guardar nueva clave</button>
  </form>
</section>
<%- include('partials/footer') %>
