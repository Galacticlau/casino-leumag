<%- include('partials/header') %>
<%- include('partials/admin-nav',{adminSection:'juegos'}) %>
<section class="dashboard-head">
  <div><span class="eyebrow"><%= settings.event_name %> · Administración</span><h1>Juegos</h1><p class="muted">La caja, los resultados y el equipo de cada mesa, en un solo vistazo.</p></div>
  <div class="dashboard-actions"><a class="button button-secondary" href="/super">Actualizar cajas</a><a class="button button-primary" href="#nuevo-juego">＋ Crear juego</a></div>
</section>
<section class="stats-grid">
  <article><span>Mesas activas</span><strong><%= games.filter(g=>g.active).length %></strong></article>
  <article><span>Caja total de mesas</span><strong>$<%= formatNumber(games.reduce((sum,g)=>sum+Number(g.table_balance||0),0)) %></strong></article>
  <article><span>Encargados disponibles</span><strong><%= users.filter(u=>u.role==='game_admin'&&u.active).length %></strong></article>
</section>
<div class="card-grid casino-tables">
  <% games.forEach(game=>{ const crew=assignments.filter(a=>Number(a.game_id)===Number(game.id)); %>
  <article class="casino-table-card <%= game.active?'':'table-inactive' %>">
    <div class="table-card-top"><span class="table-emblem" aria-hidden="true"><%= ['♠','♦','♣','♥'][Number(game.id)%4] %></span><span class="badge <%= game.active?'badge-success':'badge-muted' %>"><%= game.active?'Activa':'Inactiva' %></span></div>
    <h2><%= game.name %></h2><p class="table-description"><%= game.description||'Mesa del casino escolar' %></p>
    <div class="table-cash"><span>Monto actual de la mesa</span><strong>$<%= formatNumber(game.table_balance) %></strong><small>Caja inicial: $<%= formatNumber(game.initial_bankroll) %></small></div>
    <div class="table-metrics">
      <div><span>↗ Ganancias</span><strong>$<%= formatNumber(game.gains) %></strong><small>Apuestas perdidas por jugadores</small></div>
      <div><span>↘ Pérdidas</span><strong>$<%= formatNumber(game.losses) %></strong><small>Ganancias pagadas a jugadores</small></div>
    </div>
    <div class="table-facts"><span>Apuestas $<%= formatNumber(game.min_amount) %>–$<%= formatNumber(game.max_amount) %></span><span>Hasta <%= game.max_players %> jugadores</span></div>
    <div class="table-crew"><span class="eyebrow">Encargados</span><% crew.forEach(person=>{ %><span class="crew-name"><%= person.display_name %><%= person.active===false?' · Inactivo':'' %></span><% }) %><% if(!crew.length){ %><span class="muted">Sin encargados asignados</span><% } %></div>
    <div class="table-status"><span><%= game.waiting_count||0 %> en espera</span><span><%= game.playing_count||0 %> jugando</span></div>
    <a class="button button-primary button-wide" href="/admin/game/<%= game.id %>">Operar mesa →</a>
    <details class="table-manage"><summary>Administrar este juego</summary><div class="form-stack">
      <form method="post" action="/super/assignments" class="form-stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="gameId" value="<%= game.id %>">
        <label>Asignar encargado<select name="userId" required><option value="">Seleccionar…</option><% users.filter(u=>u.role==='game_admin'&&u.active&&!crew.some(a=>Number(a.user_id)===Number(u.id))).forEach(u=>{ %><option value="<%= u.id %>"><%= u.display_name %></option><% }) %></select></label><button class="button button-secondary" type="submit">Asignar a esta mesa</button>
      </form>
      <% crew.forEach(person=>{ %><form method="post" action="/super/assignments/remove" class="assignment-row"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="gameId" value="<%= game.id %>"><input type="hidden" name="userId" value="<%= person.user_id %>"><span><%= person.display_name %></span><button class="button button-small button-secondary" type="submit">Quitar</button></form><% }) %>
      <% if(game.availableBetOptions?.length){ %>
      <form method="post" action="/super/games/<%= game.id %>/bet-options" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Opciones para apostar (una por línea)<textarea name="options" rows="3" required maxlength="750"><%= game.availableBetOptions.join('\n') %></textarea></label><button class="button button-secondary" type="submit">Guardar botonera</button></form>
      <% } %>
      <form method="post" action="/super/games/<%= game.id %>/capacity" class="capacity-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Capacidad<input type="number" name="maxPlayers" min="1" max="10" value="<%= game.max_players %>" required></label><button class="button button-secondary" type="submit">Guardar</button></form>
      <form method="post" action="/super/games/<%= game.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-secondary button-wide" type="submit"><%= game.active?'Desactivar juego':'Activar juego' %></button></form>
    </div></details>
  </article>
  <% }) %>
  <% if(!games.length){ %><div class="empty-state">Crea tu primer juego y asigna sus encargados.</div><% } %>
</div>
<section class="panel admin-section" id="nuevo-juego">
  <div class="section-title"><div><span class="eyebrow">Nueva mesa</span><h2>Crear juego</h2></div><span class="badge badge-success">Caja inicial $30.000</span></div>
  <form method="post" action="/super/games" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Nombre del juego<input name="name" required maxlength="80" placeholder="Ej.: Mano Dorada"></label>
    <label>Apuesta mínima<input type="number" name="minAmount" min="1" value="500" required></label>
    <label>Apuesta máxima<input type="number" name="maxAmount" min="1" value="5000" required></label>
    <label>Jugadores por ronda<input type="number" name="maxPlayers" min="1" max="10" value="1" required></label>
    <label class="span-two">Descripción<textarea name="description" maxlength="500" rows="2" placeholder="Reglas breves para los participantes"></textarea></label>
    <fieldset class="crew-picker span-two"><legend>Encargados de esta mesa</legend><div class="crew-options"><% users.filter(u=>u.role==='game_admin'&&u.active).forEach(u=>{ %><label class="checkbox-label"><input type="checkbox" name="adminIds" value="<%= u.id %>"><%= u.display_name %></label><% }) %></div><% if(!users.some(u=>u.role==='game_admin'&&u.active)){ %><p class="help">Crea un encargado en Usuarios. También podrás asignarlo después.</p><% } %></fieldset>
    <button class="button button-primary" type="submit">Crear mesa con $30.000</button>
  </form>
</section>
<details class="panel admin-section" id="movimientos"><summary class="section-summary">Últimos movimientos</summary><div class="details-content">
  <div class="section-title"><div><span class="eyebrow">Auditoría</span><h2>Últimos movimientos</h2></div></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Fecha</th><th>Participante</th><th>Juego</th><th>Cambio</th><th>Registró</th><th></th></tr></thead>
      <tbody>
        <% transactions.forEach((tx) => { %>
          <tr>
            <td><%= formatDate(tx.created_at) %></td><td><%= tx.player_name %></td><td><%= tx.game_name || tx.note || 'Ajuste' %></td>
            <td class="amount <%= tx.amount > 0 ? 'positive' : 'negative' %>"><%= tx.amount > 0 ? '+' : '' %><%= formatNumber(tx.amount) %></td>
            <td><%= tx.admin_name %></td>
            <td>
              <% if (tx.type !== 'reversal' && !tx.reversed) { %>
                <form method="post" action="/super/transactions/<%= tx.id %>/reverse">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-secondary" type="submit">Revertir</button>
                </form>
              <% } else { %><small class="muted"><%= tx.reversed ? 'Revertida' : 'Reversa' %></small><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div></details>

<details class="panel admin-section" id="configuracion"><summary class="section-summary">Configuración del evento</summary><div class="details-content">
  <div class="section-title"><div><span class="eyebrow">Parámetros generales</span><h2>Configuración</h2></div></div>
  <form method="post" action="/super/settings" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Nombre del evento<input name="eventName" value="<%= settings.event_name %>" required maxlength="80"></label>
    <label>Nombre de la moneda<input name="currencyName" value="<%= settings.currency_name %>" required maxlength="30"></label>
    <label>Saldo inicial de cuentas nuevas<input type="number" name="initialBalance" value="<%= settings.initial_balance %>" min="0" required></label>
    <label class="checkbox-label"><input type="checkbox" name="allowNegative" <%= settings.allow_negative ? 'checked' : '' %>> Permitir saldo negativo</label>
    <button class="button button-primary" type="submit">Guardar configuración</button>
  </form>
</div></details>
<%- include('partials/footer') %>
