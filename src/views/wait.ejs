<%- include('partials/header') %>
<section class="narrow-panel panel wait-card" data-wait-request="<%= joinRequest.id %>" data-initial-status="<%= joinRequest.status %>">
  <div class="spinner" aria-hidden="true"></div>
  <span class="eyebrow">Participación enviada</span>
  <h1><%= joinRequest.game_name %></h1>
  <% if (joinRequest.status === 'pending') { %>
    <p id="wait-message" aria-live="polite">Estás en la fila. Espera a que el encargado inicie tu ronda.</p>
  <% } else if (joinRequest.status === 'playing') { %>
    <p id="wait-message" aria-live="polite">¡Tu ronda comenzó! Sigue las indicaciones del encargado.</p>
  <% } else if (joinRequest.status === 'used') { %>
    <p id="wait-message" aria-live="polite">Esta participación ya fue procesada.</p>
  <% } else { %>
    <p id="wait-message" aria-live="polite">Esta participación ya no está activa.</p>
  <% } %>
  <div class="balance-inline">Saldo actual: <strong id="current-balance"><%= formatNumber(joinRequest.balance) %></strong> <%= settings.currency_name %></div>
  <% if (joinRequest.status === 'pending') { %>
    <form id="cancel-wait" method="post" action="/player/request/<%= joinRequest.id %>/cancel">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="button button-secondary" type="submit">Cancelar espera</button>
    </form>
  <% } %>
  <a id="back-account" class="button button-primary <%= ['pending', 'playing'].includes(joinRequest.status) ? 'hidden' : '' %>" href="/player">Volver a mi cuenta</a>
</section>
<script src="/wait.js" defer></script>
<%- include('partials/footer') %>
