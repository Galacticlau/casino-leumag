<% const goldenKey = /llave[ -]dorada/.test(`${game.name} ${game.slug}`.toLowerCase()); if (goldenKey) { game.min_amount = 1000; game.max_amount = 1000; } %>
<%- include('partials/header') %>
<section class="narrow-panel panel game-join">
  <span class="eyebrow">Puesto de juego</span>
  <h1><%= game.name %></h1>
  <p><%= game.description || 'Consulta las reglas con la persona encargada del puesto.' %></p>
  <dl class="game-facts">
    <div><dt>Tu saldo</dt><dd><%= formatNumber(balance) %> <%= settings.currency_name %></dd></div>
    <div><dt>Movimiento permitido</dt><dd><%= formatNumber(game.min_amount) %> a <%= formatNumber(game.max_amount) %></dd></div>
    <div><dt>Participantes por ronda</dt><dd>Hasta <%= game.max_players %></dd></div>
  </dl>
  <% const options = typeof betOptions !== 'undefined' ? betOptions : []; %>
  <form method="post" action="/game/<%= game.slug %>/join" class="form-stack" id="bet-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (options.length) { %>
      <fieldset class="bet-fieldset">
        <legend>1. Elige tu apuesta</legend>
        <div class="bet-option-grid">
          <% options.forEach((option, index) => { %>
            <label class="bet-choice"><input type="radio" name="betOption" value="<%= option %>" required <%= goldenKey ? 'checked' : '' %>><span><%= option %></span></label>
          <% }) %>
        </div>
      </fieldset>
      <fieldset class="bet-fieldset">
        <legend>2. Elige cuánto apostar</legend>
        <div class="chip-buttons bet-amount-buttons">
          <% const amounts = [...new Set([Number(game.min_amount), 50, 100, 500, 1000, 2000, 5000, Number(game.max_amount)])].filter(a => a >= game.min_amount && a <= game.max_amount).sort((a,b) => a-b); %>
          <% amounts.forEach((amount) => { %>
            <button type="button" class="chip-button" data-bet-amount="<%= amount %>" aria-pressed="false" <%= amount > balance ? 'disabled' : '' %>>$<%= formatNumber(amount) %></button>
          <% }) %>
        </div>
        <label><%= goldenKey ? 'Apuesta fija' : 'Otro monto' %><input type="number" name="betAmount" id="bet-amount" value="<%= goldenKey ? 1000 : '' %>" <%= goldenKey ? 'readonly' : '' %> min="<%= game.min_amount %>" max="<%= Math.min(game.max_amount, balance) %>" inputmode="numeric" required placeholder="Ingresa un monto"></label>
      </fieldset>
      <p class="bet-summary" id="bet-summary" aria-live="polite">Elige una opción y un monto.</p>
      <p class="help">La apuesta se confirma antes de iniciar la ronda. <%= goldenKey ? 'Resultados posibles: ganar $15.000, devolución completa (saldo sin cambios) o perder solo $500.' : 'Si pierdes, se descuenta ese monto; si ganas, la encargada registra tu ganancia.' %> El saldo cambia al cerrar la ronda. Para cambiar tu apuesta, cancela la espera y vuelve a entrar.</p>
    <% } %>
    <button class="button button-primary button-wide button-large" type="submit" <%= options.length && balance < game.min_amount ? 'disabled' : '' %>><%= options.length ? 'Confirmar apuesta y entrar a la fila' : 'Avisar que estoy listo' %></button>
    <% if (options.length && balance < game.min_amount) { %><p class="help">Tu saldo no alcanza para la apuesta mínima.</p><% } %>
  </form>
  <p class="help">Tu nombre aparecerá en el notebook del puesto. El encargado registrará el resultado.</p>
</section>
<script src="/player-bet.js" defer></script>
<%- include('partials/footer') %>
