<div class="game-finances" aria-live="polite">
  <div><span>Caja inicial</span><strong data-finance="initial_bankroll">$<%= formatNumber(game.initial_bankroll) %></strong></div>
  <div><span>Monto actual de la mesa</span><strong data-finance="table_balance">$<%= formatNumber(game.table_balance) %></strong></div>
  <div><span>Ganancias de la mesa</span><strong data-finance="gains">$<%= formatNumber(game.gains) %></strong></div>
  <div><span>Pérdidas de la mesa</span><strong data-finance="losses">$<%= formatNumber(game.losses) %></strong></div>
</div>
